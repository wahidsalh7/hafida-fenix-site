          desc: "توضيح الخطوات العملية وتنظيم الوثائق والمعلومات الإرشادية المرتبطة بالإقامة والاستقرار.",
          link: ""
        },
        {
          id: "bk-1",
          type: "books",
          title: "إصدارات حفيظة فينيكس",
          desc: "كتب وروايات تناقش التجربة الإنسانية والوعي الذاتي. يمكنك إضافة روابط الشراء لكل كتاب من الإدارة.",
          link: "#payments-section"
        }
      ]
    };

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return structuredClone(DEFAULT_STATE);
        const parsed = JSON.parse(raw);
        return {
          ...structuredClone(DEFAULT_STATE),
          ...parsed,
          theme: { ...DEFAULT_STATE.theme, ...(parsed.theme || {}) },
          contacts: { ...DEFAULT_STATE.contacts, ...(parsed.contacts || {}) },
          texts: {
            ar: { ...DEFAULT_STATE.texts.ar, ...((parsed.texts && parsed.texts.ar) || {}) },
            fr: { ...DEFAULT_STATE.texts.fr, ...((parsed.texts && parsed.texts.fr) || {}) },
            es: { ...DEFAULT_STATE.texts.es, ...((parsed.texts && parsed.texts.es) || {}) }
          },
          items: Array.isArray(parsed.items) ? parsed.items : structuredClone(DEFAULT_STATE.items)
        };
      } catch {
        return structuredClone(DEFAULT_STATE);
      }
    }

    let state = loadState();
    let isAuthenticated = false;

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      renderSite();
      renderAdminItems();
      showSavedNotice();
    }

    function showSavedNotice() {
      const el = document.getElementById("saveStatus");
      el.classList.add("show");
      setTimeout(() => el.classList.remove("show"), 2500);
    }

    function getYoutubeEmbedUrl(url) {
      if (!url) return "";
      const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([A-Za-z0-9_-]{6,})/);
      return match ? `https://www.youtube.com/embed/${match[1]}` : "";
    }

    function renderSite() {
      const lang = state.lang || "ar";
      const t = state.texts[lang] || state.texts.ar;

      document.documentElement.lang = lang;
      document.documentElement.dir = t.dir;
      document.getElementById("langSwitcher").value = lang;

      document.documentElement.style.setProperty("--primary", state.theme.primary);
      document.documentElement.style.setProperty("--bg-page", state.theme.bgPage);

      const heroEl = document.querySelector(".hero");
      if (state.theme.heroBgImage) {
        heroEl.style.backgroundImage = `linear-gradient(160deg, rgba(59, 7, 100, 0.86), rgba(91, 33, 182, 0.86)), url("${state.theme.heroBgImage.replace(/"/g, "")}")`;
        heroEl.style.backgroundSize = "cover";
        heroEl.style.backgroundPosition = "center";
      } else {
        heroEl.style.backgroundImage = "";
      }

      document.getElementById("ui-site-title").textContent = t.siteTitle;
      document.getElementById("ui-site-subtitle").textContent = t.siteSubtitle;
      document.getElementById("ui-badge").textContent = t.badge;
      document.getElementById("ui-hero-title").textContent = t.heroTitle;
      document.getElementById("ui-hero-desc").textContent = t.heroDesc;
      document.getElementById("btnCallLink").textContent = t.callBtn;
      document.getElementById("btnBookLink").textContent = t.bookBtn;
      document.getElementById("btnBooksLink").textContent = t.booksBtn;
      document.getElementById("ui-services-title").textContent = t.servicesTitle;
      document.getElementById("ui-books-title").textContent = t.booksTitle;
      document.getElementById("ui-media-title").textContent = t.mediaTitle;
      document.getElementById("ui-payments-title").textContent = t.paymentsTitle;
      document.getElementById("ui-paypal-label").textContent = t.paypalLabel;
      document.getElementById("btnPaypalLink").textContent = t.paypalBtn;
      document.getElementById("ui-bank-label").textContent = t.bankLabel;
      document.getElementById("ui-footer-text").textContent = t.footerText;

      document.getElementById("btnCallLink").href = state.contacts.callUrl || "#";
      document.getElementById("btnBookLink").href = state.contacts.bookUrl || "#payments-section";
      document.getElementById("btnPaypalLink").href = state.contacts.paypalUrl || "#";
      document.getElementById("ui-paypal-info").textContent = state.contacts.paypalNote || "";
      document.getElementById("ui-bank-info").textContent = state.contacts.bankDetails || "";

      renderSectionItems("services", "servicesContainer", t.bookBtn);
      renderSectionItems("books", "booksContainer", t.booksBtn);
      renderMediaItems("mediaContainer");
    }

    function renderSectionItems(type, containerId, linkLabel) {
      const container = document.getElementById(containerId);
      const list = state.items.filter((item) => item.type === type);
      container.innerHTML = "";

      if (!list.length) {
        container.innerHTML = `<p style="color: var(--text-muted);">لا توجد عناصر مضافة في هذا القسم حالياً.</p>`;
        return;
      }

      list.forEach((item) => {
        const card = document.createElement("div");
        card.className = "item-box";

        const titleEl = document.createElement("h4");
        titleEl.textContent = item.title;

        const descEl = document.createElement("p");
        descEl.textContent = item.desc;

        card.appendChild(titleEl);
        card.appendChild(descEl);

        if (item.link) {
          const a = document.createElement("a");
          a.className = "btn btn-primary";
          a.href = item.link;
          a.textContent = linkLabel;
          if (item.link.startsWith("http")) {
            a.target = "_blank";
            a.rel = "noopener noreferrer";
          }
          card.appendChild(a);
        }

        container.appendChild(card);
      });
    }

    function renderMediaItems(containerId) {
      const container = document.getElementById(containerId);
      const list = state.items.filter((item) => item.type === "media");
      container.innerHTML = "";

      if (!list.length) {
        container.innerHTML = `<p style="color: var(--text-muted);">أضف رابط فيديو أو ملف من لوحة الإدارة ليظهر هنا.</p>`;
        return;
      }

      list.forEach((item) => {
        const card = document.createElement("div");
        card.className = "item-box";

        const titleEl = document.createElement("h4");
        titleEl.textContent = item.title;
        card.appendChild(titleEl);

        const ytEmbed = getYoutubeEmbedUrl(item.link || "");
        if (ytEmbed) {
          const frame = document.createElement("div");
          frame.className = "media-frame";
          const cleanIframe = document.createElement("iframe");
          cleanIframe.src = ytEmbed;
          cleanIframe.title = item.title;
          cleanIframe.loading = "lazy";
          cleanIframe.allowFullscreen = true;
          frame.appendChild(cleanIframe);
          card.appendChild(frame);
        } else if (item.link && /\.(mp4|webm|ogg)(\?.*)?$/i.test(item.link)) {
          const frame = document.createElement("div");
          frame.className = "media-frame";
          const video = document.createElement("video");
          video.src = item.link;
          video.controls = true;
          frame.appendChild(video);
          card.appendChild(frame);
        } else if (item.link) {
          const linkEl = document.createElement("a");
          linkEl.className = "file-link";
          linkEl.href = item.link;
          linkEl.target = "_blank";
          linkEl.rel = "noopener noreferrer";
          linkEl.textContent = item.link;
          card.appendChild(linkEl);
        }

        if (item.desc) {
          const descEl = document.createElement("p");
          descEl.textContent = item.desc;
          card.appendChild(descEl);
        }

        container.appendChild(card);
      });
    }

    function populateAdminForms() {
      const targetLang = document.getElementById("editLangTarget").value || state.lang || "ar";
      const t = state.texts[targetLang];

      document.getElementById("editBadge").value = t.badge;
      document.getElementById("editHeroTitle").value = t.heroTitle;
      document.getElementById("editHeroDesc").value = t.heroDesc;

      document.getElementById("editCallUrl").value = state.contacts.callUrl;
      document.getElementById("editBookUrl").value = state.contacts.bookUrl;
      document.getElementById("editPaypalUrl").value = state.contacts.paypalUrl;
      document.getElementById("editPaypalNote").value = state.contacts.paypalNote;
      document.getElementById("editBankDetails").value = state.contacts.bankDetails;

      document.getElementById("editPrimaryColor").value = state.theme.primary;
      document.getElementById("editBgColor").value = state.theme.bgPage;
      document.getElementById("editHeroBgImage").value = state.theme.heroBgImage || "";
      document.getElementById("editNewPass").value = "";

      renderAdminItems();
    }

    function renderAdminItems() {
      const listEl = document.getElementById("adminItemsList");
      listEl.innerHTML = "";

      if (!state.items.length) {
        listEl.innerHTML = `<p style="color: var(--text-muted);">لا توجد عناصر حالياً.</p>`;
        return;
      }

      const typeNames = { services: "قسم / خدمة", books: "كتاب", media: "فيديو / ملف" };

      state.items.forEach((item) => {
        const row = document.createElement("div");
        row.className = "admin-list-item";

        const info = document.createElement("div");
        info.innerHTML = `<strong>${item.title}</strong> <span style="color: var(--text-muted); font-size: 0.85rem;">(${typeNames[item.type] || item.type})</span>`;

        const delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.className = "btn btn-danger";
        delBtn.textContent = "حذف";
        delBtn.addEventListener("click", () => {
          state.items = state.items.filter((x) => x.id !== item.id);
          saveState();
        });

        row.appendChild(info);
        row.appendChild(delBtn);
        listEl.appendChild(row);
      });
    }

    document.getElementById("langSwitcher").addEventListener("change", (e) => {
      state.lang = e.target.value;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      renderSite();
    });

    const modal = document.getElementById("adminModal");
    document.getElementById("openAdminBtn").addEventListener("click", () => {
      modal.classList.add("open");
      modal.setAttribute("aria-hidden", "false");
      if (isAuthenticated) {
        document.getElementById("loginBox").style.display = "none";
        document.getElementById("dashboardBox").style.display = "block";
        document.getElementById("modalTitle").textContent = "لوحة تحكم الإدارة";
        populateAdminForms();
      } else {
        document.getElementById("loginBox").style.display = "block";
        document.getElementById("dashboardBox").style.display = "none";
        document.getElementById("modalTitle").textContent = "دخول الإدارة";
        document.getElementById("adminPassInput").value = "";
        document.getElementById("loginError").style.display = "none";
      }
    });

    document.getElementById("closeModalBtn").addEventListener("click", () => {
      modal.classList.remove("open");
      modal.setAttribute("aria-hidden", "true");
    });

    document.getElementById("loginSubmitBtn").addEventListener("click", () => {
      const pass = document.getElementById("adminPassInput").value;
      if (pass === state.adminPass) {
        isAuthenticated = true;
        document.getElementById("loginBox").style.display = "none";
        document.getElementById("dashboardBox").style.display = "block";
        document.getElementById("modalTitle").textContent = "لوحة تحكم الإدارة";
        populateAdminForms();
      } else {
        document.getElementById("loginError").style.display = "block";
      }
    });

    document.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
        document.querySelectorAll(".tab-pane").forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById(btn.dataset.tab).classList.add("active");
      });
    });

    document.getElementById("editLangTarget").addEventListener("change", () => {
      const lang = document.getElementById("editLangTarget").value;
      const t = state.texts[lang];
      document.getElementById("editBadge").value = t.badge;
      document.getElementById("editHeroTitle").value = t.heroTitle;
      document.getElementById("editHeroDesc").value = t.heroDesc;
    });

    document.getElementById("saveLangBtn").addEventListener("click", () => {
      const lang = document.getElementById("editLangTarget").value;
      state.texts[lang].badge = document.getElementById("editBadge").value.trim();
      state.texts[lang].heroTitle = document.getElementById("editHeroTitle").value.trim();
      state.texts[lang].heroDesc = document.getElementById("editHeroDesc").value.trim();
      saveState();
    });

    document.getElementById("addItemBtn").addEventListener("click", () => {
      const type = document.getElementById("newItemType").value;
      const title = document.getElementById("newItemTitle").value.trim();
      const link = document.getElementById("newItemLink").value.trim();
      const desc = document.getElementById("newItemDesc").value.trim();
      if (!title) return;

      state.items.push({ id: "item-" + Date.now(), type, title, link, desc });
      document.getElementById("newItemTitle").value = "";
      document.getElementById("newItemLink").value = "";
      document.getElementById("newItemDesc").value = "";
      saveState();
    });

    document.getElementById("savePaymentsBtn").addEventListener("click", () => {
      state.contacts.callUrl = document.getElementById("editCallUrl").value.trim();
      state.contacts.bookUrl = document.getElementById("editBookUrl").value.trim();
      state.contacts.paypalUrl = document.getElementById("editPaypalUrl").value.trim();
      state.contacts.paypalNote = document.getElementById("editPaypalNote").value.trim();
      state.contacts.bankDetails = document.getElementById("editBankDetails").value.trim();
      saveState();
    });

    document.getElementById("saveAppearanceBtn").addEventListener("click", () => {
      state.theme.primary = document.getElementById("editPrimaryColor").value;
      state.theme.bgPage = document.getElementById("editBgColor").value;
      state.theme.heroBgImage = document.getElementById("editHeroBgImage").value.trim();
      const newPass = document.getElementById("editNewPass").value.trim();
      if (newPass) state.adminPass = newPass;
      saveState();
    });

    document.getElementById("exportJsonBtn").addEventListener("click", () => {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "hafida-fenix-backup.json";
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById("resetDefaultBtn").addEventListener("click", () => {
      state = structuredClone(DEFAULT_STATE);
      saveState();
      populateAdminForms();
    });

    renderSite();
  </script>
<!-- HAFIDA_CLEAN_START -->
<style id="hafidaCleanStyle">
