<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>حفيظة فينيكس | Hafida Fénix</title>
  <style>
    :root {
      --primary: #5b21b6;
      --primary-dark: #3b0764;
      --primary-light: #ede9fe;
      --accent: #7c3aed;
      --bg-page: #f8f7fc;
      --bg-card: #ffffff;
      --text-main: #1e1b4b;
      --text-muted: #5b5877;
      --border: #ddd6fe;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      line-height: 1.7;
    }

    a { text-decoration: none; color: inherit; }

    header {
      background: linear-gradient(135deg, var(--primary-dark), var(--primary));
      color: #ffffff;
      padding: 1rem 1.25rem;
      position: sticky;
      top: 0;
      z-index: 40;
      box-shadow: 0 4px 16px rgba(59, 7, 100, 0.18);
    }

    .header-inner {
      max-width: 1120px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .brand h1 { font-size: 1.35rem; font-weight: 800; }
    .brand span { display: block; font-size: 0.85rem; opacity: 0.9; }
    .header-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

    select, button, input, textarea { font-family: inherit; font-size: 0.92rem; }

    .lang-select {
      background: rgba(255, 255, 255, 0.16);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 8px;
      padding: 0.45rem 0.75rem;
      cursor: pointer;
    }

    .lang-select option { color: #1e1b4b; background: #ffffff; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      border: none;
      border-radius: 10px;
      padding: 0.58rem 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s ease, opacity 0.15s ease, background-color 0.2s ease;
    }

    .btn:hover { transform: translateY(-1px); opacity: 0.96; }
    .btn-white { background: #ffffff; color: var(--primary-dark); }
    .btn-primary { background: var(--primary); color: #ffffff; }
    .btn-outline { background: transparent; color: var(--primary); border: 1.5px solid var(--primary); }
    .btn-danger { background: #b91c1c; color: #ffffff; }

    .hero {
      background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 65%, var(--accent) 100%);
      color: #ffffff;
      padding: 3rem 1.25rem;
    }

    .hero-inner { max-width: 1120px; margin: 0 auto; }

    .hero-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.18);
      border: 1px solid rgba(255, 255, 255, 0.3);
      padding: 0.3rem 0.85rem;
      border-radius: 999px;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }

    .hero h2 { font-size: clamp(1.6rem, 3.5vw, 2.5rem); line-height: 1.3; margin-bottom: 1rem; max-width: 820px; }
    .hero p { font-size: 1.03rem; max-width: 780px; color: #f5f3ff; margin-bottom: 1.5rem; }
    .action-bar { display: flex; flex-wrap: wrap; gap: 0.7rem; }

    main { max-width: 1120px; margin: 0 auto; padding: 2rem 1.25rem 3.5rem; display: grid; gap: 2rem; }

    .section-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 6px 20px rgba(91, 33, 182, 0.06);
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.1rem;
      padding-bottom: 0.65rem;
      border-bottom: 2px solid var(--primary-light);
    }

    .section-header h3 { font-size: 1.25rem; color: var(--primary-dark); }
    .grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.1rem; }

    .item-box {
      border: 1px solid var(--border);
      background: #fcfbff;
      border-radius: 12px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .item-box h4 { color: var(--primary-dark); font-size: 1.05rem; }
    .item-box p { color: var(--text-muted); font-size: 0.94rem; }

    .media-frame {
      width: 100%;
      border-radius: 10px;
      overflow: hidden;
      background: #140926;
      aspect-ratio: 16 / 9;
    }

    .media-frame iframe, .media-frame video { width: 100%; height: 100%; border: 0; display: block; }

    .file-link {
      display: inline-block;
      margin-top: 0.35rem;
      color: var(--primary);
      font-weight: 700;
      font-size: 0.9rem;
      word-break: break-all;
    }

    .payment-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }

    .payment-box {
      background: var(--primary-light);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.1rem;
    }

    .payment-box h4 { color: var(--primary-dark); margin-bottom: 0.45rem; }
    .payment-box p { color: var(--text-main); font-size: 0.95rem; margin-bottom: 0.8rem; word-break: break-word; }

    footer { background: var(--primary-dark); color: #ede9fe; text-align: center; padding: 1.5rem 1rem; font-size: 0.9rem; }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(19, 7, 38, 0.72);
      display: none;
      align-items: flex-start;
      justify-content: center;
      padding: 1.5rem 1rem;
      overflow-y: auto;
      z-index: 100;
    }

    .modal-backdrop.open { display: flex; }

    .modal-panel {
      width: 100%;
      max-width: 820px;
      background: #ffffff;
      border-radius: 18px;
      padding: 1.5rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
      border: 1px solid var(--border);
    }

    .modal-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.2rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .modal-top h3 { color: var(--primary-dark); font-size: 1.2rem; }
    .admin-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }

    .tab-btn {
      padding: 0.5rem 0.9rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg-page);
      color: var(--primary-dark);
      font-weight: 700;
      cursor: pointer;
    }

    .tab-btn.active { background: var(--primary); color: #ffffff; border-color: var(--primary); }
    .tab-pane { display: none; }
    .tab-pane.active { display: grid; gap: 0.9rem; }
    .field-group { display: grid; gap: 0.35rem; }
    .field-group label { font-weight: 700; font-size: 0.9rem; color: var(--primary-dark); }

    .field-group input, .field-group textarea, .field-group select {
      width: 100%;
      padding: 0.65rem 0.8rem;
      border: 1px solid #c4b5fd;
      border-radius: 9px;
      background: #ffffff;
      color: var(--text-main);
    }

    .field-group textarea { min-height: 85px; resize: vertical; }
    .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.8rem; }
    .admin-list { display: grid; gap: 0.6rem; margin-top: 0.5rem; }

    .admin-list-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.7rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--bg-page);
    }

    .status-msg {
      padding: 0.65rem 0.9rem;
      border-radius: 9px;
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
      font-weight: 600;
      display: none;
    }

    .status-msg.show { display: block; }
  </style>
</head>
