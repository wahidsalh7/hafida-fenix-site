{
  "name": "@cloudflare/workers-utils",
  "version": "0.55.0",
  "description": "Internal utility package for workers-sdk. Not intended for external use — APIs may change without notice.",
  "homepage": "https://github.com/cloudflare/workers-sdk/tree/main/packages/workers-utils#readme",
  "bugs": {
    "url": "https://github.com/cloudflare/workers-sdk/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "workers-devprod@cloudflare.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudflare/workers-sdk.git",
    "directory": "packages/workers-utils"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": "./dist/browser.mjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./prometheus-metrics": {
      "import": "./dist/prometheus-metrics.mjs",
      "types": "./dist/prometheus-metrics.d.mts"
    },
    "./compliance": {
      "import": "./dist/compliance.mjs",
      "types": "./dist/compliance.d.mts"
    },
    "./test-helpers": {
      "import": "./dist/test-helpers/index.mjs",
      "types": "./dist/test-helpers/index.d.mts"
    },
    "./fs-helpers": {
      "import": "./dist/fs-helpers.mjs",
      "types": "./dist/fs-helpers.d.mts"
    },
    "./compatibility-date": {
      "import": "./dist/compatibility-date.mjs",
      "types": "./dist/compatibility-date.d.mts"
    },
    "./docker-path": {
      "import": "./dist/docker-path.mjs",
      "types": "./dist/docker-path.d.mts"
    },
    "./node-compat": {
      "types": "./dist/node-compat.d.mts",
      "import": "./dist/node-compat.mjs"
    },
    "./sourcemap": {
      "types": "./dist/sourcemap.d.mts",
      "import": "./dist/sourcemap.mjs"
    },
    "./errors": {
      "import": "./dist/errors.mjs",
      "types": "./dist/errors.d.mts"
    },
    "./custom-api-headers": {
      "import": "./dist/custom-api-headers.mjs",
      "types": "./dist/custom-api-headers.d.mts"
    },
    "./global-wrangler-config-path": {
      "import": "./dist/global-wrangler-config-path.mjs",
      "types": "./dist/global-wrangler-config-path.d.mts"
    },
    "./local-env": {
      "import": "./dist/local-env.mjs",
      "types": "./dist/local-env.d.mts"
    },
    "./zod-format": {
      "import": "./dist/zod-format.mjs",
      "types": "./dist/zod-format.d.mts"
    },
    "./sanitize-headers": {
      "import": "./dist/sanitize-headers.mjs",
      "types": "./dist/sanitize-headers.d.mts"
    }
  },
  "dependencies": {
    "@cspotcode/source-map-support": "0.8.1",
    "chalk": "5.3.0",
    "dotenv": "16.3.1",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@types/command-exists": "^1.2.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "22.15.17",
    "@vitest/ui": "5.0.4",
    "ci-info": "4.4.0",
    "cloudflare": "^5.2.0",
    "command-exists": "1.2.9",
    "concurrently": "^8.2.2",
    "dotenv-expand": "13.0.0",
    "empathic": "^2.0.0",
    "jsonc-parser": "3.2.0",
    "minimatch": "^5.1.9",
    "open": "11.0.0",
    "signal-exit": "4.1.0",
    "smol-toml": "1.9.0",
    "ts-dedent": "^2.2.0",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "vitest": "5.0.4",
    "xdg-app-paths": "^8.3.0",
    "zod": "4.6.6",
    "@cloudflare/workers-shared": "0.20.3",
    "@cloudflare/workers-tsconfig": "0.0.0",
    "@cloudflare/workflows-shared": "0.15.3"
  },
  "peerDependencies": {
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "volta": {
    "extends": "../../package.json"
  },
  "workers-sdk": {
    "prerelease": true
  },
  "scripts": {
    "build": "tsdown",
    "check:type": "tsc -p ./tsconfig.json",
    "deploy": "echo 'no deploy'",
    "dev": "concurrently -c black,blue --kill-others-on-fail false \"pnpm tsdown --watch\" \"pnpm run check:type --watch --preserveWatchOutput\"",
    "test": "vitest",
    "test:ci": "vitest run",
    "type:tests": "tsc -p ./tests/tsconfig.json"
  }
}